# Public Masjid and Madrasah homepages are eligible for search indexing.
# The student application form remains noindex; its confidential submissions use the portal API.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://images.unsplash.com https://i.ytimg.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://portal.attowfiqmasjid.org; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests

# Keep the public form out of results; visitors reach it from the Madrasah homepage.
https://madrasah.attowfiqmasjid.org/apply/*
  X-Robots-Tag: noindex, nofollow
/madrasah/apply/*
  X-Robots-Tag: noindex, nofollow
